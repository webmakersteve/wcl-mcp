{
  "name": "wcl-mcp",
  "version": "0.3.0",
  "description": "Local MCP server giving an agent context on World of Warcraft runs from Warcraft Logs, backed by DuckDB.",
  "type": "module",
  "bin": {
    "wcl-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "login": "tsx src/index.ts login",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.3.4-alpha.27",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "cbor-x": "^1.6.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
