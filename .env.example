# Warcraft Logs v2 API credentials (OAuth client-credentials).
# Create a "v2 API client" at https://www.warcraftlogs.com/api/clients/
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Your numeric Warcraft Logs user id. Required for find_reports (your uploads).
# Client-credentials auth has no "current user" context, so this must be supplied explicitly.
# Find it in the URL of your profile page: https://www.warcraftlogs.com/user/<WCL_USER_ID>
WCL_USER_ID=

# Where the local DuckDB file lives. Defaults to ./data/wcl.duckdb if unset.
WCL_DB_PATH=./data/wcl.duckdb
