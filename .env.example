# Warcraft Logs v2 API credentials.
# WCL_CLIENT_ID defaults to the built-in wcl-mcp client; set it to use your own
# "v2 API client" from https://www.warcraftlogs.com/api/clients/
# WCL_CLIENT_ID=
# Needed for public-report access without logging in. Optional after `wcl-mcp login` if the
# client is a public (PKCE-only) client.
WCL_CLIENT_SECRET=

# `wcl-mcp login` (user OAuth, for private reports). The redirect URI must exactly match one
# registered on the API client. Tokens are stored at WCL_AUTH_PATH (mode 0600).
WCL_REDIRECT_URI=http://localhost:8888/redirect
# Defaults to ~/.config/wcl-mcp/auth.json (Windows: %APPDATA%\wcl-mcp\auth.json).
# WCL_AUTH_PATH=~/.config/wcl-mcp/auth.json

# Your numeric Warcraft Logs user id, for find_reports (your uploads). Not needed once logged in.
# Find it in the URL of your profile page: https://www.warcraftlogs.com/user/<WCL_USER_ID>
WCL_USER_ID=

# Override where the local DuckDB file lives. Defaults to a per-user data directory:
#   macOS:   ~/Library/Application Support/wcl-mcp/wcl.duckdb
#   Windows: %LOCALAPPDATA%\wcl-mcp\wcl.duckdb
#   Linux:   $XDG_DATA_HOME/wcl-mcp/wcl.duckdb (~/.local/share/wcl-mcp/wcl.duckdb)
# WCL_DB_PATH=./data/wcl.duckdb
